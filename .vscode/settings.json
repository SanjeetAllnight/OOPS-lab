{
    "java.debug.settings.onBuildFailureProceed": true,
    "java.server.launchMode": "Standard",
    "java.project.sourcePaths": [
        "."
    ],
    "java.project.outputPath": "bin",
    "java.project.resourceFilters": [
        "node_modules",
        ".git",
        "bin",
        ".vscode"
    ],
    "editor.inlineSuggest.edits.showLongDistanceHint": false,
    "editor.inlineSuggest.enabled": false,
    "editor.inlineSuggest.suppressInSnippetMode": false,
    "editor.inlineSuggest.syntaxHighlightingEnabled": false,
    "editor.screenReaderAnnounceInlineSuggestion": false,
    "github.copilot.chat.languageContext.typescript.enabled": false
}
